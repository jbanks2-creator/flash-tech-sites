# Names only — never commit real values. Copy to `.env` (chmod 600, git-ignored) on the box.
# NODE_ENV=production
# PORT=3000
#
# --- Contact-form delivery (`/api/contact`, web/lib/contact-mail.mjs) -------------------------
# The provider is a value: resend | postmark | smtp. Leave CONTACT_PROVIDER empty and the site is
# still honest — the CTA renders as a mailto link and POST refuses with a 503 naming it — but no
# message is delivered. Fill in ONE provider's block to make the form send.
#
# CONTACT_PROVIDER=resend
# CONTACT_FROM=Flash Tech website <website@flashtech.biz>   # on a domain the provider verified
# CONTACT_TO=support@flashtech.biz                          # default
# CONTACT_FALLBACK_EMAIL=                                   # default: TheWiz@FlashTech.Biz (the
#                                                           # address the site's own copy publishes)
#
# Resend (free tier; the domain must be verified by DNS: DKIM TXT + SPF include):
# CONTACT_API_KEY=re_...
#
# Postmark (paid; server token from the server's "API Tokens" tab):
# CONTACT_API_KEY=...
# CONTACT_POSTMARK_STREAM=outbound
#
# SMTP with an app password (no new vendor; weakest deliverability for a business inbox):
# CONTACT_PROVIDER=smtp
# CONTACT_SMTP_HOST=smtp.example.com
# CONTACT_SMTP_PORT=587
# CONTACT_SMTP_USER=site@flashtech.biz
# CONTACT_SMTP_PASS=...
# CONTACT_SMTP_SECURE=0                                     # 1 for implicit TLS on 465
#
# Spam control (defaults shown): 5 submissions per client per 15 minutes, plus a honeypot field.
# CONTACT_RATE_LIMIT=5
# CONTACT_RATE_WINDOW_SECONDS=900
#
# TaskApp storefront (see docs/STORE-DEPLOY.md). The demo must be a different origin from
# the site: the store page embeds it and it must never share this site's browser storage.
# STORE_DEMO_ORIGIN=http://127.0.0.1:3602
# STORE_SUPPORT_EMAIL=            # Jerry's real support mailbox — decision pending
# LEMONSQUEEZY_CHECKOUT_URL=      # Lemon Squeezy TEST-mode checkout URL
# STORE_LIVE=0                    # 1 only when Jerry flips it (docs/store/LAUNCH.md)
